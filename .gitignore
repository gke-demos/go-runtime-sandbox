# Local MCP working configs — hold absolute paths that are per-machine.
# Templates live in cmd/mcp-server/{claude-code.mcp.json,gemini-cli.settings.json}.example;
# each dev copies one to the location its tool expects and the working
# files stay out of git.
.mcp.json
.gemini/

# Build output
bin/

# Claude Code per-user overrides
.claude/settings.local.json

# Local agent-specific overlay; canonical agent guide lives in AGENTS.md
CLAUDE.md

# IDE / editor metadata
.idea
.vscode
*.swp
